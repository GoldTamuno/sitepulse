# Copy this to .env for local (non-Docker) development.
# In Docker Compose these are set directly in docker-compose.yml.
# In Railway, set these in the project's Variables tab.

APP_ENV=development
HTTP_PORT=8080

# Local Postgres (matches deployments/docker-compose.yml)
DATABASE_URL=postgres://sitepulse:sitepulse@localhost:5432/sitepulse?sslmode=disable

# Use a long random value in production, e.g. `openssl rand -hex 32`
JWT_SECRET=dev-secret-change-me

# --- Scheduler / worker pool tuning ---
CHECKER_POOL_SIZE=10
CHECKER_TIMEOUT=10s
SCHEDULER_TICK=5s
SLOW_RESPONSE_THRESHOLD=2s

# --- Notifications (Phase 7) — all optional. Leave blank to disable that channel. ---
# Email (SMTP). Example values for Gmail (use an App Password, not your real password):
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Webhook — any URL that accepts a JSON POST (Slack Incoming Webhooks work directly).
WEBHOOK_URL=

# Warn this many days before a monitor's TLS certificate expires.
CERT_EXPIRY_WARN_DAYS=14
